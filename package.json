{
  "name": "nextjs-starter-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "generate-schema": "dotenv -c -- bash -c 'gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: $DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\" ${DATOCMS_ENVIRONMENT:+--header \"X-Environment: $DATOCMS_ENVIRONMENT\"} && gql.tada generate-output'",
    "generate-cma-types": "dotenv -c -- bash -c 'npx datocms schema:generate src/lib/datocms/cma-types.ts --api-token $DATOCMS_CMA_TOKEN'",
    "generate-fluid-tokens": "node scripts/generate-fluid-tokens.mjs && prettier --write src/app/tokens/fluid.css",
    "generate-breakpoint-tokens": "node scripts/generate-breakpoint-tokens.mjs && prettier --write src/app/tokens/breakpoints.css",
    "format": "npx prettier . --write",
    "prepare": "npx simple-git-hooks && npm run generate-schema && npm run generate-cma-types"
  },
  "dependencies": {
    "@datocms/cda-client": "^0.3.1",
    "@datocms/cma-client": "^6.1.0",
    "@datocms/content-link": "^0.3.21",
    "@mux/mux-player-react": "^3.13.0",
    "@types/highlight.js": "^10.1.0",
    "datocms-plugin-sdk": "^2.1.5",
    "datocms-react-ui": "^2.1.5",
    "datocms-structured-text-to-plain-text": "^5.1.16",
    "datocms-structured-text-utils": "^5.1.16",
    "embla-carousel-react": "^8.6.0",
    "gql.tada": "^1.9.0",
    "highlight.js": "^11.11.1",
    "next": "^16",
    "next-intl": "^4.13.7",
    "node-html-parser": "^7.0.1",
    "react": "^19",
    "react-datocms": "^8.0.5",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "datocms": "^4.0.26",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "prettier": "3.7.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format"
  }
}
